#include <iostream>
using namespace std;
int sumOfCircularArray(int arr[], int n) {
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }
    return sum;
}

int main() {
    int n;
    cout << "Enter the number of elements in the array: ";
    cin >> n;

    int arr[n];
    cout << "Enter the elements of the array: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    int sum = sumOfCircularArray(arr, n);
    cout << "Sum of the circular array: " << sum << endl;

    return 0;
}
