#include <iostream>
using namespace std;

int main() {
    int start, end;
    int sumOdd = 0, sumEven = 0;
    cout << "Enter the start of the range: ";
    cin >> start;
    cout << "Enter the end of the range: ";
    cin >> end;
    for (int i = start; i <= end; ++i) {
        if (i % 2 == 0) {
            sumEven += i; 
        } else {
            sumOdd += i;  
        }
    }
    cout << "Sum of even numbers: " << sumEven << endl;
    cout << "Sum of odd numbers: " << sumOdd << endl;

    return 0;
}
