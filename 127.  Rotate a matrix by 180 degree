#include <iostream>
using namespace std;

void rotateMatrix180(int matrix[][100], int rows, int cols) {
    for (int i = 0; i < rows / 2; ++i) {
        for (int j = 0; j < cols; ++j) {
            swap(matrix[i][j], matrix[rows - 1 - i][cols - 1 - j]);
        }
    }
    if (rows % 2 == 1) {
        for (int j = 0; j < cols / 2; ++j) {
            swap(matrix[rows / 2][j], matrix[rows / 2][cols - 1 - j]);
        }
    }
}
void printMatrix(int matrix[][100], int rows, int cols) {
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }
}

int main() {
    int rows, cols;
    int matrix[100][100]; 
    cout << "Enter the number of rows: ";
    cin >> rows;
    cout << "Enter the number of columns: ";
    cin >> cols;
    cout << "Enter the elements of the matrix:" << endl;
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cin >> matrix[i][j];
        }
    }
    rotateMatrix180(matrix, rows, cols);
    cout << "Rotated matrix by 180 degrees:" << endl;
    printMatrix(matrix, rows, cols);

    return 0;
}
