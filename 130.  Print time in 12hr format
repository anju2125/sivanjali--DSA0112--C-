#include <iostream>
#include <ctime> 

using namespace std;

int main() {
    time_t now = time(0);
    tm *ltm = localtime(&now);
    int hour = ltm->tm_hour; 
    int minute = ltm->tm_min;
    int second = ltm->tm_sec;
    string ampm = (hour >= 12) ? "PM" : "AM";
    hour = hour % 12; 
    if (hour == 0) {
        hour = 12;  
    }
    cout << "Current time: " 
         << hour << ":" 
         << (minute < 10 ? "0" : "") << minute << ":" 
         << (second < 10 ? "0" : "") << second << " " 
         << ampm << endl;

    return 0;
}
